# Игнорируем систему контроля версий и кэш
.git/
.cache/

# Игнорируем зависимости и кэш
node_modules/
.npm/
__pycache__/

# Игнорируем файлы окружения и секреты
.env
*.key
*.pem
*.p12

# Игнорируем логи и временные файлы
*.log
tmp/

# Игнорируем каталоги сборки
dist/
build/
target/
out/

# Игнорируем файлы конфигурации редакторов
.vscode/
.idea/
*.swp

# Игнорируем инфраструктуру и её локальное состояние: в образе скрапера не нужно
infra/
**/.terraform/
*.tfstate
*.tfstate.*

# Игнорируем локальное виртуальное окружение Python
venv/
.venv/

# Игнорируем контейнерную обвязку (образ собирается только из src/)
docker-compose.yaml
